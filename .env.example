# Optional. Nothing here is required to run the app.

# URL of YOUR backend endpoint that creates a checkout session with a payment
# provider (e.g. Stripe Checkout, Payme, Click) and returns JSON: { "url": "https://..." }.
# When empty, real checkout is disabled.
VITE_CHECKOUT_URL=

# Enables the clearly labelled development-only checkout (no money is charged)
# in production builds. It is always enabled under `npm run dev`.
VITE_ENABLE_DEV_CHECKOUT=false

# Password for the /admin settings page. It ships inside the JavaScript bundle, so it only keeps
# casual visitors out; it is not real access control. When empty, /admin is locked in production
# builds and accepts "admin" under `npm run dev`.
VITE_ADMIN_PASSWORD=
